# PhoneInfoga scanner credentials
# Copy this file to `.env` and fill in real values, then run `phoneinfoga serve`.
# `.env` is gitignored — never commit real credentials.

# --- Numverify (apilayer) scanner ---
# Standard validation (country, location, line type, carrier). This is an
# apilayer "Number Verification API" key, NOT a numverify.com key.
NUMVERIFY_API_KEY=

# --- Twilio Lookup v2 scanner ---
# Required to enable the Twilio scanner.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Optional: comma-separated Lookup v2 data packages (default: line_type_intelligence)
# TWILIO_LOOKUP_FIELDS=line_type_intelligence

# --- Breach / leak (Dehashed) scanner ---
# Opt-in gate: the breach scanner stays disabled unless this is truthy.
BREACH_SCANNER_ENABLED=true
# Required when the breach scanner is enabled.
DEHASHED_EMAIL=
DEHASHED_API_KEY=
# Optional: include raw breach field values in results (sensitive third-party data).
# BREACH_INCLUDE_FIELDS=false

# --- HLR (live network status) scanner ---
# Provider-agnostic: requires BOTH an API key and a real provider endpoint.
# The scanner is skipped cleanly until HLR_API_URL points at a configured
# provider (Abstract HLR, IPQS HLR, apilayer, etc.). It only runs for mobile
# numbers.
HLR_API_KEY=
HLR_API_URL=

# --- IPQualityScore (fraud/reputation) scanner ---
# Required to enable the ipqualityscore scanner.
IPQS_API_KEY=

# --- Validation scanners (Numverify alternatives) ---
# Each provider runs as its own scanner; configure only the ones you use.
VERIPHONE_API_KEY=
ABSTRACT_PHONE_API_KEY=
NUMLOOKUPAPI_API_KEY=

# --- NANPA (North American numbering-plan) scanner ---
# Requires a configured NPA-NXX endpoint; runs only for +1 numbers and is
# skipped cleanly when NANPA_API_URL is empty.
NANPA_API_URL=
# Optional: only if your NANPA provider requires authentication.
# NANPA_API_KEY=

# --- SerpAPI (search-engine footprint) scanner ---
# Required to enable the serpapi scanner.
SERPAPI_KEY=
# Optional: comma-separated SerpAPI engines (default: google).
# SERPAPI_ENGINES=google
# Optional: max organic results kept per dork (default: 3; 0 = unlimited).
# SERPAPI_MAX_RESULTS=3
